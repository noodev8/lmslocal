# Copy to .env.local for local development, and set the same key in the Vercel project settings.
#
# Points the admin tool at the LMSLocal Express API. If unset, the client falls back to
# http://localhost:3015, which is what you want when running the server locally.
NEXT_PUBLIC_API_URL=http://localhost:3015

# Points "View as organiser" at the player-facing app, so it knows where to open the new tab.
# If unset, the client picks by its own hostname at runtime: localhost:3000 when the admin tool is
# served from localhost, https://www.lmslocal.co.uk otherwise. Only set this to override that,
# e.g. to point a local admin tool at a deployed web app.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
